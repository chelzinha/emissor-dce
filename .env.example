# URL do Web App publicado no Google Apps Script.
APPS_SCRIPT_URL=https://script.google.com/macros/s/SEU_DEPLOYMENT_ID/exec

# Segredo compartilhado somente entre Netlify Functions e Apps Script.
APPS_SCRIPT_TOKEN=troque-por-um-segredo-longo

# Use true apenas em desenvolvimento local. Nunca ative em producao.
DCE_ALLOW_DEV_AUTH=false

# Limite tecnico por chamada ao gateway. O lote total nao tem limite fixo.
DCE_MAX_PER_REQUEST=5

# 2 = homologacao, 1 = producao. Producao tambem exige confirmacao no corpo.
DCE_DEFAULT_ENVIRONMENT=2

# Endpoints nacionais oficiais.
DCE_AUTH_URL_HOMOLOG=https://homologacao.dce.fazenda.pr.gov.br/dce/DCeAutorizacao
DCE_AUTH_URL_PRODUCTION=https://dce.fazenda.pr.gov.br/dce/DCeAutorizacao
DCE_STATUS_URL_HOMOLOG=https://homologacao.dce.fazenda.pr.gov.br/dce/DCeStatusServico
DCE_STATUS_URL_PRODUCTION=https://dce.fazenda.pr.gov.br/dce/DCeStatusServico
DCE_CONSULT_URL_HOMOLOG=https://homologacao.dce.fazenda.pr.gov.br/dce/DCeConsulta
DCE_CONSULT_URL_PRODUCTION=https://dce.fazenda.pr.gov.br/dce/DCeConsulta
DCE_EVENT_URL_HOMOLOG=https://homologacao.dce.fazenda.pr.gov.br/dce/DCeRecepcaoEvento
DCE_EVENT_URL_PRODUCTION=https://dce.fazenda.pr.gov.br/dce/DCeRecepcaoEvento
DCE_QRCODE_URL=https://www.fazenda.pr.gov.br/dce/qrcode

# Namespace e SOAPAction ficam configuraveis para acompanhar eventuais ajustes do WSDL.
DCE_AUTH_WSDL_NS=http://www.portalfiscal.inf.br/dce/wsdl/DCeAutorizacao
DCE_AUTH_SOAP_ACTION=http://www.portalfiscal.inf.br/dce/wsdl/DCeAutorizacao/dceAutorizacao
DCE_STATUS_WSDL_NS=http://www.portalfiscal.inf.br/dce/wsdl/DCeStatusServico
DCE_STATUS_SOAP_ACTION=http://www.portalfiscal.inf.br/dce/wsdl/DCeStatusServico/dceStatusServico
DCE_CONSULT_WSDL_NS=http://www.portalfiscal.inf.br/dce/wsdl/DCeConsulta
DCE_CONSULT_SOAP_ACTION=http://www.portalfiscal.inf.br/dce/wsdl/DCeConsulta/dceConsulta
DCE_EVENT_WSDL_NS=http://www.portalfiscal.inf.br/dce/wsdl/DCeRecepcaoEvento
DCE_EVENT_SOAP_ACTION=http://www.portalfiscal.inf.br/dce/wsdl/DCeRecepcaoEvento/dceRecepcaoEvento
DCE_EVENT_ORG_CODE=91
