function trackingSummary_(userId,payload){const campaignId=String(payload.campaignId||'');requireCampaignAccess_(campaignId,userId);const objects=sheetRows_(getSheet_('POSTAL_OBJECTS')).filter(function(row){return String(row.CAMPAIGN_ID)===campaignId;}),events=trackingEventsForCampaign_(campaignId),latest=trackingLatestByObject_(events),pac=trackingBucket_(objects,latest,'PAC'),sedex=trackingBucket_(objects,latest,'SEDEX'),total=trackingBucket_(objects,latest,'');return{campaignId:campaignId,updatedAt:events.reduce(function(value,row){return String(row.CREATED_AT||'')>value?String(row.CREATED_AT||''):value;},''),latestEventAt:events.reduce(function(value,row){return String(row.EVENT_AT||'')>value?String(row.EVENT_AT||''):value;},''),pac:pac,sedex:sedex,total:total,closure:trackingClosureFromBucket_(total)};}
