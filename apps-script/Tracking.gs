function trackingObjectsList_(userId,payload){const campaignId=String(payload.campaignId||'');requireCampaignAccess_(campaignId,userId);const service=String(payload.service||'').trim().toUpperCase();if(service&&['PAC','SEDEX'].indexOf(service)===-1)throw new Error('Servico deve ser PAC ou SEDEX.');const category=String(payload.category||'').trim().toUpperCase(),allowedCategories=TRACKING_CATEGORIES_.concat(['AWAITING_UPDATE']);if(category&&allowedCategories.indexOf(category)===-1)throw new Error('Categoria de rastreamento invalida.');const offset=Math.max(0,Number(payload.offset||0)),limit=Math.max(1,Math.min(500,Number(payload.limit||250))),rows=trackingSnapshotRows_(campaignId).filter(function(row){return(!service||row.service===service)&&(!category||row.category===category);});return{campaignId:campaignId,total:rows.length,offset:offset,limit:limit,rows:rows.slice(offset,offset+limit)};}
function trackingGeoSummary_(userId,payload){const campaignId=String(payload.campaignId||'');requireCampaignAccess_(campaignId,userId);const service=String(payload.service||'').trim().toUpperCase();if(service&&['PAC','SEDEX'].indexOf(service)===-1)throw new Error('Servico deve ser PAC ou SEDEX.');const limit=Math.max(1,Math.min(200,Number(payload.limit||30))),groups={};trackingSnapshotRows_(campaignId).forEach(function(row){if(service&&row.service!==service)return;const city=String(row.recipient.city||'').trim()||'SEM CIDADE',uf=String(row.recipient.uf||'').trim().toUpperCase(),key=city.toUpperCase()+'|'+uf;if(!groups[key])groups[key]={city:city,uf:uf,posted:0,delivered:0,returned:0,awaitingUpdate:0,inProgress:0,attention:0,unknown:0};const group=groups[key];group.posted+=1;if(row.category==='DELIVERED')group.delivered+=1;else if(row.category==='RETURNED')group.returned+=1;else if(row.category==='AWAITING_UPDATE')group.awaitingUpdate+=1;else if(row.category==='POSTED'||row.category==='IN_TRANSIT'||row.category==='OUT_FOR_DELIVERY')group.inProgress+=1;else if(row.category==='EXCEPTION'||row.category==='RETURNING')group.attention+=1;else group.unknown+=1;});const rows=Object.keys(groups).map(function(key){const group=groups[key];group.terminal=group.delivered+group.returned;group.pending=Math.max(0,group.posted-group.terminal);group.deliveryRate=group.posted?Math.round(group.delivered/group.posted*100):0;group.completionRate=group.posted?Math.round(group.terminal/group.posted*100):0;return group;}).sort(function(a,b){if(b.posted!==a.posted)return b.posted-a.posted;return(a.city+a.uf).localeCompare(b.city+b.uf);});return{campaignId:campaignId,totalCities:rows.length,rows:rows.slice(0,limit)};}
