const TRACKING_CATEGORIES_ = Object.freeze(['POSTED','IN_TRANSIT','OUT_FOR_DELIVERY','DELIVERED','EXCEPTION','RETURNING','RETURNED','UNKNOWN']);
function trackingNormalizeCode_(value){return String(value||'').replace(/\s/g,'').toUpperCase();}
function trackingNormalizeCategory_(value){const category=String(value||'UNKNOWN').trim().toUpperCase();return TRACKING_CATEGORIES_.indexOf(category)===-1?'UNKNOWN':category;}
function trackingSourceKey_(row){return [trackingNormalizeCode_(row.trackingCode),String(row.eventAt||''),trackingNormalizeCategory_(row.category),String(row.status||'').trim().toUpperCase(),String(row.description||'').trim().toUpperCase(),String(row.location||'').trim().toUpperCase()].join('|').slice(0,700);}
function trackingObjectStatus_(category){const map={POSTED:'POSTED',IN_TRANSIT:'TRACKING_IN_TRANSIT',OUT_FOR_DELIVERY:'TRACKING_OUT_FOR_DELIVERY',DELIVERED:'TRACKING_DELIVERED',EXCEPTION:'TRACKING_EXCEPTION',RETURNING:'TRACKING_RETURNING',RETURNED:'TRACKING_RETURNED',UNKNOWN:'TRACKING_UNKNOWN'};return map[trackingNormalizeCategory_(category)]||'TRACKING_UNKNOWN';}
function trackingEventPublic_(row){return{id:String(row.ID||''),campaignId:String(row.CAMPAIGN_ID||''),postalObjectId:String(row.POSTAL_OBJECT_ID||''),trackingCode:String(row.TRACKING_CODE||''),service:String(row.SERVICE||''),category:String(row.CATEGORY||''),status:String(row.STATUS||''),description:String(row.DESCRIPTION||''),location:String(row.LOCATION||''),eventAt:String(row.EVENT_AT||''),source:String(row.SOURCE||''),sourceKey:String(row.SOURCE_KEY||''),createdAt:String(row.CREATED_AT||'')};}
function trackingEventsForCampaign_(campaignId){return sheetRows_(getSheet_('TRACKING_EVENTS')).filter(function(row){return String(row.CAMPAIGN_ID)===String(campaignId);});}
function trackingLatestByObject_(rows){const latest={};rows.forEach(function(row){const objectId=String(row.POSTAL_OBJECT_ID||'');if(!objectId)return;const current=latest[objectId];if(!current||String(row.EVENT_AT||'')>String(current.EVENT_AT||'')||(String(row.EVENT_AT||'')===String(current.EVENT_AT||'')&&String(row.CREATED_AT||'')>String(current.CREATED_AT||'')))latest[objectId]=row;});return latest;}
function trackingAppendUpdates_(userId,payload){const campaignId=String(payload.campaignId||'');requireCampaignAccess_(campaignId,userId,['AGENCY_ADMIN']);const rows=Array.isArray(payload.rows)?payload.rows:[];if(!rows.length||rows.length>Number(DCE_CONFIG.MAX_TRACKING_CHUNK||200))throw new Error('Bloco de rastreamento invalido.');const source=String(payload.source||'CSV_IMPORT').trim().slice(0,80)||'CSV_IMPORT';const objects=sheetRows_(getSheet_('POSTAL_OBJECTS')).filter(function(row){return String(row.CAMPAIGN_ID)===campaignId;});const byTracking={};objects.forEach(function(row){byTracking[trackingNormalizeCode_(row.TRACKING_CODE)]=row;});const currentEvents=trackingEventsForCampaign_(campaignId),existingKeys={};currentEvents.forEach(function(row){existingKeys[trackingNormalizeCode_(row.TRACKING_CODE)+'|'+String(row.SOURCE_KEY||'')]=true;});const latest=trackingLatestByObject_(currentEvents),records=[],latestUpdates={},errors=[];let duplicates=0;const now=nowIso_();rows.forEach(function(input,index){const trackingCode=trackingNormalizeCode_(input.trackingCode),object=byTracking[trackingCode];if(!/^[A-Z]{2}\d{9}[A-Z]{2}$/.test(trackingCode)){errors.push({row:index+1,trackingCode:trackingCode,error:'SRO_INVALIDO'});return;}if(!object){errors.push({row:index+1,trackingCode:trackingCode,error:'SRO_NAO_PERTENCE_A_OPERACAO'});return;}const objectStatus=String(object.STATUS||'');if(objectStatus!=='POSTED'&&objectStatus.indexOf('TRACKING_')!==0){errors.push({row:index+1,trackingCode:trackingCode,error:'OBJETO_NAO_CONFIRMADO_COMO_POSTADO'});return;}const category=trackingNormalizeCategory_(input.category),eventDate=new Date(String(input.eventAt||''));if(isNaN(eventDate.getTime())){errors.push({row:index+1,trackingCode:trackingCode,error:'DATA_EVENTO_INVALIDA'});return;}const eventAt=eventDate.toISOString(),candidate={trackingCode:trackingCode,eventAt:eventAt,category:category,status:String(input.status||'').slice(0,220),description:String(input.description||'').slice(0,500),location:String(input.location||'').slice(0,220)},sourceKey=String(input.sourceKey||trackingSourceKey_(candidate)).slice(0,700),uniqueKey=trackingCode+'|'+sourceKey;if(existingKeys[uniqueKey]){duplicates+=1;return;}existingKeys[uniqueKey]=true;const record={ID:uuid_(),CAMPAIGN_ID:campaignId,POSTAL_OBJECT_ID:String(object.ID),TRACKING_CODE:trackingCode,SERVICE:String(object.SERVICE||''),CATEGORY:category,STATUS:candidate.status,DESCRIPTION:candidate.description,LOCATION:candidate.location,EVENT_AT:eventAt,SOURCE:source,SOURCE_KEY:sourceKey,CREATED_BY:userId,CREATED_AT:now};records.push(record);const prior=latest[String(object.ID)];if(!prior||eventAt>=String(prior.EVENT_AT||'')){latest[String(object.ID)]=record;latestUpdates[String(object.ID)]={object:object,record:record};}});if(records.length)appendObjects_('TRACKING_EVENTS',records);Object.keys(latestUpdates).forEach(function(objectId){const item=latestUpdates[objectId];updateRow_('POSTAL_OBJECTS',item.object._rowNumber,{STATUS:trackingObjectStatus_(item.record.CATEGORY),UPDATED_AT:nowIso_()});});records.filter(function(record){return record.CATEGORY==='DELIVERED';}).forEach(function(record){const object=byTracking[trackingNormalizeCode_(record.TRACKING_CODE)];if(!object)return;recordOperationEvent_(userId,{campaignId:campaignId,type:'TRACKING_DELIVERED',service:String(object.SERVICE||''),quantity:1,sourceType:'POSTAL_OBJECT',sourceId:String(object.ID),occurredAt:record.EVENT_AT,idempotencyKey:'tracking-delivered:'+String(object.ID),metadata:{trackingCode:record.TRACKING_CODE,source:source,trackingSourceKey:record.SOURCE_KEY}});});return{received:rows.length,inserted:records.length,duplicates:duplicates,errors:errors,summary:trackingSummary_(userId,{campaignId:campaignId})};}
function trackingBucket_(objects,latestByObject,service){const selected=objects.filter(function(row){return !service||String(row.SERVICE||'')===String(service);}),out={totalObjects:selected.length,posted:0,tracked:0,awaitingUpdate:0,inTransit:0,outForDelivery:0,delivered:0,exception:0,returning:0,returned:0,unknown:0};selected.forEach(function(object){const status=String(object.STATUS||''),eligible=status==='POSTED'||status.indexOf('TRACKING_')===0;if(!eligible)return;out.posted+=1;const event=latestByObject[String(object.ID)];if(!event){out.awaitingUpdate+=1;return;}out.tracked+=1;const category=trackingNormalizeCategory_(event.CATEGORY);if(category==='IN_TRANSIT'||category==='POSTED')out.inTransit+=1;else if(category==='OUT_FOR_DELIVERY')out.outForDelivery+=1;else if(category==='DELIVERED')out.delivered+=1;else if(category==='EXCEPTION')out.exception+=1;else if(category==='RETURNING')out.returning+=1;else if(category==='RETURNED')out.returned+=1;else out.unknown+=1;});return out;}
function trackingSummary_(userId,payload){const campaignId=String(payload.campaignId||'');requireCampaignAccess_(campaignId,userId);const objects=sheetRows_(getSheet_('POSTAL_OBJECTS')).filter(function(row){return String(row.CAMPAIGN_ID)===campaignId;}),events=trackingEventsForCampaign_(campaignId),latest=trackingLatestByObject_(events);return{campaignId:campaignId,updatedAt:events.reduce(function(value,row){return String(row.EVENT_AT||'')>value?String(row.EVENT_AT||''):value;},''),pac:trackingBucket_(objects,latest,'PAC'),sedex:trackingBucket_(objects,latest,'SEDEX'),total:trackingBucket_(objects,latest,'')};}
function trackingEventsList_(userId,payload){const campaignId=String(payload.campaignId||'');requireCampaignAccess_(campaignId,userId);const trackingCode=trackingNormalizeCode_(payload.trackingCode),from=String(payload.from||''),to=String(payload.to||''),limit=Math.max(1,Math.min(1000,Number(payload.limit||200)));return trackingEventsForCampaign_(campaignId).filter(function(row){const eventAt=String(row.EVENT_AT||'');return(!trackingCode||trackingNormalizeCode_(row.TRACKING_CODE)===trackingCode)&&(!from||eventAt.slice(0,10)>=from)&&(!to||eventAt.slice(0,10)<=to);}).sort(function(a,b){return String(b.EVENT_AT||'').localeCompare(String(a.EVENT_AT||''));}).slice(0,limit).map(trackingEventPublic_);}
